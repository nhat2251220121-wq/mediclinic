PORT=5000
NODE_ENV=development

# Database Config (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mediclinic_db
DB_PORT=3306

# Doctor shifts are subdivided into this many-minute appointment slots (10-120).
BOOKING_SLOT_MINUTES=30

# JWT Secret
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
REFUND_PII_ENCRYPTION_KEY=replace_with_a_separate_random_secret_at_least_32_characters

# Browser application origins (comma separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Email OTP (leave unset until SMTP credentials are configured)
EMAIL_USER=
EMAIL_PASS=

# OpenAI Responses API (server-side only; never expose this key to the frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Bank transfer / SePay
BANK_NAME=
BANK_ACCOUNT=
ACCOUNT_NAME=
SEPAY_API_KEY=
