PORT=5000
NODE_ENV=development

# Database Config (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mediclinic_db
DB_PORT=3306

# Doctor shifts are subdivided into this many-minute appointment slots (10-120).
BOOKING_SLOT_MINUTES=30

# JWT Secret
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Browser application origins (comma separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Email OTP (leave unset until SMTP credentials are configured)
EMAIL_USER=
EMAIL_PASS=

# Google Gemini AI API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Bank transfer / SePay
BANK_NAME=
BANK_ACCOUNT=
ACCOUNT_NAME=
SEPAY_API_KEY=
