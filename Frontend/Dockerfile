FROM node:24-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ARG VITE_API_BASE_URL=/api
ARG VITE_UPLOADS_BASE_URL=
ARG VITE_CLINIC_ADDRESS=
ARG VITE_CLINIC_PHONE=
ARG VITE_CLINIC_EMAIL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_UPLOADS_BASE_URL=${VITE_UPLOADS_BASE_URL}
ENV VITE_CLINIC_ADDRESS=${VITE_CLINIC_ADDRESS}
ENV VITE_CLINIC_PHONE=${VITE_CLINIC_PHONE}
ENV VITE_CLINIC_EMAIL=${VITE_CLINIC_EMAIL}
RUN npm run build

FROM nginx:stable-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
